{
  "expo": {
    "name": "CropDiseaseApp",
    "slug": "CropDiseaseApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cropdiseaseapp",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cropdisease.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1A12"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.cropdisease.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to analyze plant images.",
          "cameraPermission": "The app needs access to your camera to take photos of plants."
        }
      ]
    ]
  }
}
